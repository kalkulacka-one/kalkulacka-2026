# CDN root serving calculator data; unset runs the app on committed fixtures.
DATA_ENDPOINT=https://data.kalkulacka.one/www.volebnikalkulacka.cz
# CockroachDB connection string; unset disables all session routes (503).
DATABASE_URL=
# Base name for the session cookie; unset disables all session routes (503).
NEXT_PUBLIC_SESSION_COOKIE_NAME=
# ISO timestamp of the last production DB reset; session cookies older than
# this are treated as stale and a fresh session is created instead of reused.
DATABASE_INITIALIZED_AT=
