# CDN root serving calculator data; unset runs the app on committed fixtures.
DATA_ENDPOINT=https://data.kalkulacka.one/www.volebnikalkulacka.cz
# CockroachDB connection string; unset disables all session routes (503).
DATABASE_URL=
# Base name for the session cookie; unset disables all session routes (503).
NEXT_PUBLIC_SESSION_COOKIE_NAME=
# ISO timestamp of the last production DB reset; session cookies older than
# this are treated as stale and a fresh session is created instead of reused.
DATABASE_INITIALIZED_AT=
# Public origin of this deployment, e.g. https://www.volebnikalkulacka.cz.
# Only `generateMetadata` reads it, and only to make a shared result's
# `og:image` absolute — social crawlers reject a relative one. Unset leaves
# Next's own default resolution in place.
NEXT_PUBLIC_BASE_URL=
# Which registered locale (@vk/i18n) this build serves. Unset resolves to the
# catalog's DEFAULT_LOCALE ("cs" today); a value naming no registered locale
# throws at request time rather than silently falling back.
NEXT_PUBLIC_LOCALE=
# Plausible site id, e.g. www.volebnikalkulacka.cz; unset renders no script tag and sends no request.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# AppSignal frontend monitoring key; unset skips the client SDK entirely (no init, no breadcrumbs, no sendError).
NEXT_PUBLIC_APPSIGNAL_FRONTEND_KEY=
# AppSignal app label/environment/push key for server-side OTel export; all three must be set or `instrumentation.ts` registers nothing.
APPSIGNAL_NAME=
APPSIGNAL_ENVIRONMENT=
APPSIGNAL_PUSH_API_KEY=
# Where @vercel/otel actually sends spans, e.g. an AppSignal OTLP collector URL; unset leaves the exporter with nowhere to send to.
OTEL_EXPORTER_OTLP_ENDPOINT=
