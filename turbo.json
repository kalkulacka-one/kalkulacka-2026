{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      // Themes compile to CSS that the app imports, and that output is
      // generated rather than committed — so a fresh clone must build it
      // before the dev server can resolve the import.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // Prisma generates into node_modules, outside any cacheable output dir —
    // a cache hit would skip generation entirely on a machine that has never
    // run it, which is exactly the machine that needs it.
    "@vk/database#build": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
